background yes
double_buffer yes

lua_load /home/USUARIO/.conky/scripts/click_actions.lua
lua_mouse_hook conky_click_process_panel
lua_draw_hook_post conky_draw_process_panel

alignment top_right
xinerama_head 0

border_width 1
cpu_avg_samples 2
default_color white
default_outline_color white
default_shade_color white
draw_borders no
draw_graph_borders yes
draw_outline no
draw_shades no

gap_x 20
gap_y 728
net_avg_samples 2
no_buffers yes
out_to_console no
out_to_stderr no
extra_newline no

own_window yes
own_window_type normal
own_window_transparent yes
own_window_colour 000000
own_window_argb_visual no
own_window_argb_value 0
own_window_hints undecorated,below,sticky,skip_taskbar,skip_pager

minimum_size 210 0
stippled_borders 0
update_interval 2.0
uppercase no
use_spacer none

show_graph_scale no
show_graph_range no

use_xft yes
xftalpha 0.8
xftfont Droid Sans:size=11
color0 white
color1 EAEAEA
color2 FFA300
color3 grey

TEXT
