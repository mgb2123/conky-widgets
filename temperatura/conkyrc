# **********************************************************************
# "Temperatura" - widget de temperatura CPU/SSD/placa a juego con
# "Process Panel" y "Gotham", alineado en el centro derecha.
# **********************************************************************

background yes
double_buffer yes

lua_load /home/USUARIO/.conky/scripts/click_actions.lua
lua_mouse_hook conky_click_temperatura
lua_draw_hook_post conky_draw_temperatura

alignment top_right
xinerama_head 0

border_width 1
default_color white
default_outline_color white
default_shade_color white
draw_borders no
draw_graph_borders yes
draw_outline no
draw_shades no

gap_x 20
gap_y 227
no_buffers yes
out_to_console no
out_to_stderr no
extra_newline no

own_window yes
own_window_type normal
own_window_transparent yes
own_window_colour 000000
own_window_argb_visual no
own_window_argb_value 0
own_window_hints undecorated,below,sticky,skip_taskbar,skip_pager

minimum_size 210 0
stippled_borders 0
update_interval 2.0
uppercase no
use_spacer none

use_xft yes
xftalpha 0.8
xftfont Droid Sans:size=11
color0 white
color1 EAEAEA
color2 FFA300
color3 grey

TEXT
${color2}TEMPERATURA ${color0}
${color2}${hr 1}${color0}
${color3}CPU (Pkg)${alignr}${if_match ${hwmon coretemp temp 1}>80}${color FF3333}${else}${if_match ${hwmon coretemp temp 1}>60}${color FFA300}${else}${color 8AFF8A}${endif}${endif}${hwmon coretemp temp 1}°C${color0}
${color3}Frecuencia${alignr}${color EAEAEA}${freq_g}GHz${color0}
${color3}Core0 ${if_match ${hwmon coretemp temp 2}>80}${color FF3333}${else}${if_match ${hwmon coretemp temp 2}>60}${color FFA300}${else}${color 8AFF8A}${endif}${endif}${hwmon coretemp temp 2}°C${color3}  Core1 ${if_match ${hwmon coretemp temp 3}>80}${color FF3333}${else}${if_match ${hwmon coretemp temp 3}>60}${color FFA300}${else}${color 8AFF8A}${endif}${endif}${hwmon coretemp temp 3}°C${color0}
${color3}Core2 ${if_match ${hwmon coretemp temp 4}>80}${color FF3333}${else}${if_match ${hwmon coretemp temp 4}>60}${color FFA300}${else}${color 8AFF8A}${endif}${endif}${hwmon coretemp temp 4}°C${color3}  Core3 ${if_match ${hwmon coretemp temp 5}>80}${color FF3333}${else}${if_match ${hwmon coretemp temp 5}>60}${color FFA300}${else}${color 8AFF8A}${endif}${endif}${hwmon coretemp temp 5}°C${color0}
${color3}Placa base${alignr}${if_match ${hwmon acpitz temp 1}>70}${color FF3333}${else}${if_match ${hwmon acpitz temp 1}>55}${color FFA300}${else}${color 8AFF8A}${endif}${endif}${hwmon acpitz temp 1}°C${color0}
${color2}${hr 1}${color0}
${color2}SSD (NVMe)${color0}
${color3}Composite${alignr}${if_match ${hwmon nvme temp 1}>70}${color FF3333}${else}${if_match ${hwmon nvme temp 1}>50}${color FFA300}${else}${color 8AFF8A}${endif}${endif}${hwmon nvme temp 1}°C${color0}
